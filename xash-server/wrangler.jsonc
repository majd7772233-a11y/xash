{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xash-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_OBJECT",
        "class_name": "MAGDRoomObject"
      },
      {
        "name": "ROOM_REGISTRY",
        "class_name": "MAGDRegistryObject"
      }
    ]
  },

  "exports": {
    "MAGDRoomObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MAGDRegistryObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
